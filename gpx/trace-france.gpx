      <trkpt lat="43.2200" lon="-1.1500"></trkpt>
      <trkpt lat="43.1636" lon="-1.2367"><name>SAINT-JEAN-PIED-DE-PORT (J65 + R7-R8) - FIN FRANCE - Credencial n.3</name></trkpt>
    </trkseg>
  </trk>

</gpx>
