    <desc>Vallee de la Creuse, Marche, variante ouest GR654 par Le Dorat, Bellac, Oradour-sur-Glane</desc>
    <type>GR654 + variante ouest</type>
    <trkseg>
      <trkpt lat="46.8103" lon="1.6911"><name>Chateauroux</name></trkpt>
      <trkpt lat="46.7200" lon="1.6300"><name>Velles (J35)</name></trkpt>
      <trkpt lat="46.5880" lon="1.5200"><name>Argenton-sur-Creuse (J36)</name></trkpt>
      <trkpt lat="46.5240" lon="1.5940"><name>Gargilesse</name></trkpt>
      <trkpt lat="46.3860" lon="1.6240"><name>Crozant (J37)</name></trkpt>
      <trkpt lat="46.3000" lon="1.5500"></trkpt>
      <trkpt lat="46.2370" lon="1.4870"><name>La Souterraine (J38) - bifurcation variante ouest</name></trkpt>
      <trkpt lat="46.2200" lon="1.2800"></trkpt>
      <trkpt lat="46.2147" lon="1.0820"><name>Le Dorat (J39)</name></trkpt>
      <trkpt lat="46.1225" lon="1.0490"><name>Bellac (J40)</name></trkpt>
      <trkpt lat="46.0380" lon="0.9560"><name>Mortemart</name></trkpt>
      <trkpt lat="45.9339" lon="1.0328"><name>ORADOUR-SUR-GLANE (J41)</name></trkpt>
      <trkpt lat="45.8800" lon="1.1500"></trkpt>
      <trkpt lat="45.8336" lon="1.2611"><name>LIMOGES (J42 + R4) - 2e paire chaussures</name></trkpt>
    </trkseg>
  </trk>

  <trk>
    <name>SEG-K - Limoges -> PERIGUEUX (110 km / 6 etapes)</name>
    <desc>Monts de Chalus, Perigord vert via Thiviers et Sorges</desc>
    <type>GR654</type>
    <trkseg>
      <trkpt lat="45.8336" lon="1.2611"><name>Limoges</name></trkpt>
      <trkpt lat="45.7900" lon="1.1400"><name>Aixe-sur-Vienne</name></trkpt>
      <trkpt lat="45.7100" lon="1.0800"><name>Flavignac (J43)</name></trkpt>
      <trkpt lat="45.6530" lon="0.9800"><name>Chalus (J44)</name></trkpt>
      <trkpt lat="45.5400" lon="0.9700"><name>La Coquille (J45)</name></trkpt>
      <trkpt lat="45.4160" lon="0.9200"><name>Thiviers (J46)</name></trkpt>
      <trkpt lat="45.3000" lon="0.8600"><name>Sorges (J47)</name></trkpt>
      <trkpt lat="45.1842" lon="0.7211"><name>PERIGUEUX (J48 + R5) - Eschif de Creyssac</name></trkpt>
    </trkseg>
  </trk>

  <trk>
    <name>SEG-L - Perigueux -> La Reole (117 km / 6 etapes)</name>
    <desc>Vallee de l'Isle, Dordogne, Entre-deux-Mers</desc>
    <type>GR654</type>
    <trkseg>
      <trkpt lat="45.1842" lon="0.7211"><name>Perigueux</name></trkpt>
      <trkpt lat="45.1450" lon="0.5300"><name>Saint-Astier (J49)</name></trkpt>
      <trkpt lat="45.0400" lon="0.3600"><name>Mussidan (J50)</name></trkpt>
      <trkpt lat="44.9800" lon="0.2000"></trkpt>
      <trkpt lat="44.9770" lon="0.0600"><name>Villefranche-de-Lonchat (J51)</name></trkpt>
      <trkpt lat="44.9440" lon="0.2160"><name>Sainte-Foy-la-Grande (J52) - marche sam</name></trkpt>
      <trkpt lat="44.7800" lon="0.1500"></trkpt>
      <trkpt lat="44.6500" lon="0.0800"><name>Monsegur (J53)</name></trkpt>
      <trkpt lat="44.5820" lon="-0.0360"><name>LA REOLE (J54)</name></trkpt>
    </trkseg>
  </trk>

  <trk>
    <name>SEG-M - La Reole -> MONT-DE-MARSAN (92 km / 4 etapes) - Landes</name>
    <desc>Bazadais puis foret des Landes. EAU RARE - 2,5-3L chaque matin. Pas de bivouac sauvage.</desc>
    <type>GR654</type>
    <trkseg>
      <trkpt lat="44.5820" lon="-0.0360"><name>La Reole</name></trkpt>
      <trkpt lat="44.4320" lon="-0.2140"><name>Bazas (J55) - ravito 48h</name></trkpt>
      <trkpt lat="44.2940" lon="-0.2730"><name>Captieux (J56)</name></trkpt>
      <trkpt lat="44.1500" lon="-0.3000"></trkpt>
      <trkpt lat="44.0330" lon="-0.3250"><name>Roquefort (J57)</name></trkpt>
      <trkpt lat="43.9600" lon="-0.4200"></trkpt>
      <trkpt lat="43.8900" lon="-0.4990"><name>MONT-DE-MARSAN (J58 + R6)</name></trkpt>
    </trkseg>
  </trk>

  <trk>
    <name>SEG-N - Mont-de-Marsan -> Saint-Palais (92 km / 5 etapes)</name>
    <desc>Chalosse puis Bearn via Saint-Sever, Hagetmau, Orthez, Sauveterre</desc>
    <type>GR654</type>
    <trkseg>
      <trkpt lat="43.8900" lon="-0.4990"><name>Mont-de-Marsan</name></trkpt>
      <trkpt lat="43.7580" lon="-0.5740"><name>Saint-Sever (J59)</name></trkpt>
      <trkpt lat="43.6550" lon="-0.5930"><name>Hagetmau (J60)</name></trkpt>
      <trkpt lat="43.5700" lon="-0.6800"></trkpt>
      <trkpt lat="43.4890" lon="-0.7710"><name>Orthez (J61)</name></trkpt>
      <trkpt lat="43.4010" lon="-0.9420"><name>Sauveterre-de-Bearn (J62)</name></trkpt>
      <trkpt lat="43.3260" lon="-1.0330"><name>SAINT-PALAIS (J63)</name></trkpt>
    </trkseg>
  </trk>

  <trk>
    <name>SEG-O - Saint-Palais -> SAINT-JEAN-PIED-DE-PORT (32 km / 2 etapes)</name>
    <desc>Basse-Navarre. Stele de Gibraltar (convergence des 3 voies), Ostabat, arrivee SJPP</desc>
    <type>GR654 final</type>
    <trkseg>
      <trkpt lat="43.3260" lon="-1.0330"><name>Saint-Palais</name></trkpt>
      <trkpt lat="43.2840" lon="-1.0700"><name>Stele de Gibraltar</name></trkpt>
