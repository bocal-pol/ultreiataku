APP_NAME=Ultreiataku
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Brussels
APP_URL=http://localhost:8096

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_BE

# Slug d'application transmis au SSO central (X-App-ID).
AUTH_APP_ID=ultreiataku
APP_PANEL=site

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Base de données — cluster PARTAGÉ site-pgsql ────────────────────────────
# Piège Bug Rule shared_pgsql_db_password : DB_PASSWORD=password littéral obligatoire.
# Création DB requise :
#   docker exec sitev26-site-pgsql-1 psql -U sail -c "CREATE DATABASE ultreiataku OWNER sail;"
DB_CONNECTION=pgsql
DB_HOST=site-pgsql
DB_PORT=5432
DB_DATABASE=ultreiataku
DB_USERNAME=sail
DB_PASSWORD=password

# ─── Sessions — Redis chiffré, cookie httpOnly ───────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ─── Queue / Cache — cluster Redis PARTAGÉ avec préfixe ultreiataku ──────────
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=ultreiataku_cache

REDIS_CLIENT=phpredis
REDIS_HOST=site-redis
REDIS_PASSWORD=password
REDIS_PORT=6379
REDIS_PREFIX=ultreiataku:

# ─── SSO central (Auth/backend) ──────────────────────────────────────────────
AUTH_VERIFY_URL=http://auth-app/api/auth/verify
AUTH_API_URL=http://auth-app
AUTH_LOGIN_URL=http://localhost:5176/login

# ─── Sanctum / CORS — SPA frontend (5181) + admin (8096) ────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost:5181,localhost:8096
CORS_ALLOWED_ORIGINS=http://localhost:5181,http://localhost:8096
ULTREIATAKU_FRONTEND_ORIGINS=http://localhost:5181

# ─── MinIO — Object Storage S3-compatible (cluster partagé) ──────────────────
# Buckets : ultreiataku-gpx (traces GPX privées), ultreiataku-journal (photos journal)
#           ultreiataku-images (images du module pilgrimage)
# Jamais disk('public') — cf. bug_rule_merged_minio_disk
MINIO_ENDPOINT=http://site-minio:9000
MINIO_KEY=sitev26
MINIO_SECRET=sitev26password
MINIO_REGION=us-east-1
MINIO_BUCKET_GPX=ultreiataku-gpx
MINIO_BUCKET_JOURNAL=ultreiataku-journal
MINIO_BUCKET_IMAGES=ultreiataku-images

AWS_ACCESS_KEY_ID="${MINIO_KEY}"
AWS_SECRET_ACCESS_KEY="${MINIO_SECRET}"
AWS_DEFAULT_REGION="${MINIO_REGION}"
AWS_BUCKET="${MINIO_BUCKET_GPX}"
AWS_ENDPOINT="${MINIO_ENDPOINT}"
AWS_USE_PATH_STYLE_ENDPOINT=true

# ─── Module Pilgrimage — GPX Simplification (ADR-U05) ────────────────────────
# Tolérance Douglas-Peucker (degrés décimaux) : 0.0001 ≈ 11m de précision
# Cache TTL (secondes) : 86400 = 24h
PILGRIMAGE_GPX_TOLERANCE=0.0001
PILGRIMAGE_GPX_CACHE_TTL=86400

# ─── Mail (dev : log) ────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="pilgrim@ultreiataku.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

ULTREIATAKU_VERSION=1.0.0
